.venv/
.cache/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.mechlab/
artifacts/
# 개발 실행이 저장소 루트에 만드는 시험 폴더. 실제 시험 자료는 저장소 밖에서 관리한다.
/test/
# 실행 때마다 갱신되는 시작 로그.
MECHLab-시작로그.txt

# IDE 설정과 도구 로그는 개발자 환경에 속한다.
.idea/
.playwright-mcp/

# tileserver-gl 렌더링용 빌드 입력. 101MB라 받아서 쓴다.
tools/tileserver/fonts/

# 타일팩은 tools/ 스크립트로 굽는 산출물이다. 전국 팩은 1 GB다.
asset/maps/*.mbtiles

# 참고용 원본 자료는 저장소 밖에서 공유한다. 합계 20MB 가까이 된다.
asset/UI작업 관련자료/
asset/*.hwp

# SQLite 임시 파일. 타일팩을 읽는 중에 생겼다 사라진다.
*.mbtiles-journal
*.mbtiles-wal
